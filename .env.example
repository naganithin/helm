# One key, or several separated by commas: when one hits its daily free limit (HTTP 429) the next is used.
OPENROUTER_API_KEYS=
OPENROUTER_MODELS=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free,recursive/flint-v1.0:free,liquid/lfm-3-1.7b:free
NEXT_PUBLIC_WALLET_NETWORK=testnet

# live settlement: helm (Circle testnet USDC on NEAR, default) or tidepool
NEXT_PUBLIC_SETTLEMENT=helm

# Helm treasury (market maker) key: 64 hex chars, server only. Pays gains / receives losses in Helm settlement.
HELM_TREASURY_SEED=
